#include <cstring>

class N {
public:
    N(int n);

    virtual int operator+(N &rhs); // vtable[0] — c'est elle qui est appelée dynamiquement dans main()
    int operator-(N &rhs);
    void setAnnotation(char *str);

private:
    char annotation[100]; // offset 0x04, taille 0x64 (100 octets)
    int  n;               // offset 0x68
};
// taille totale de l'objet : 0x6c (108 octets) → cohérent avec operator.new(0x6c)

N::N(int n)
{
    // *(undefined ***)this = &PTR_operator+_08048848;
    // → initialisation implicite du vtable pointer par le compilateur (classe polymorphe)
    this->n = n;
}

int N::operator+(N &rhs)
{
    return rhs.n + this->n;
}

int N::operator-(N &rhs)
{
    return this->n - rhs.n;
}

void N::setAnnotation(char *str)
{
    size_t len = strlen(str);
    memcpy(this->annotation, str, len);
}

int main(int argc, char **argv)
{
    if (argc < 2) {
        exit(1);
    }

    N *a = new N(5);
    N *b = new N(6);

    a->setAnnotation(argv[1]);

    // Appel virtuel : équivalent à b->operator+(*a)
    // mais effectué via la vtable (b->vtable[0])(b, a)
    (*(int (**)(N*, N*))(*(void***)b))(b, a);

    return 0;
}